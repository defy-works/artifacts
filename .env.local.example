# ============================================
# Artifacts — local env template
# Copy to .env.local and fill with real values. Never commit .env.local.
# ============================================

# Postgres connection string (the only datastore: metadata, docs, blobs).
DATABASE_URL=postgres://artifacts:artifacts@localhost:55432/artifacts

# Public origin of this app — used for cookies, OAuth callbacks, share
# links and the API base URL the skill uses.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth (console.cloud.google.com). Leave empty for email+password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: comma-separated emails allowed to sign up. Empty = anyone.
ALLOWED_EMAILS=

# Sendsprite (defy.works' SES-backed email API) for magic-link sign-in and
# share invites. Without a key, emails are logged to the server console
# instead of sent (the sign-in link is printed there).
SENDSPRITE_API_KEY=
# Only for a self-hosted Sendsprite instance; defaults to https://sendsprite.com
SENDSPRITE_URL=
# Must be on a domain verified in Sendsprite.
EMAIL_FROM=Artifacts <artifacts@defy.works>
