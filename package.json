{
  "name": "artifacts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,mjs}\""
  },
  "dependencies": {
    "better-auth": "~1.5.5",
    "drizzle-orm": "^0.44.0",
    "next": "^15.1.4",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sendsprite": "^0.4.0",
    "sonner": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "bun-types": "^1.3.12",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
